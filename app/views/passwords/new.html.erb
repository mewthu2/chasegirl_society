<div class="login">
  <%= render "sessions/brand_side" %>
  <section class="login-form-side">
    <div class="login-card">
      <div><div class="eyebrow">Acesso</div><h2>Esqueci minha senha</h2><p class="muted">Informe seu e-mail ou o @ do Instagram. Enviaremos um link para o e-mail cadastrado.</p></div>
      <%= form_with url: passwords_path, class: "form", data: { turbo: false } do |f| %>
        <div class="field"><%= f.label :login, "E-mail ou @ do Instagram" %><%= f.text_field :login, required: true, autofocus: true, autocapitalize: "none", spellcheck: false, placeholder: "voce@email.com ou @seuinstagram" %></div>
        <%= f.button class: "btn btn-primary btn-lg btn-block" do %>Enviar link <i class="fa-solid fa-paper-plane"></i><% end %>
      <% end %>
      <p class="muted small"><%= link_to "← Voltar para o login", new_session_path %></p>
    </div>
  </section>
</div>
