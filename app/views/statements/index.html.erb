<% content_for :title, "A pagar" %>
<% content_for :crumb_parent, tag.span("Financeiro") %>
<% total = @statements.sum { _1.amount_payable.to_d } %>
<% by_due = @statements.group_by(&:due_on) %>

<div class="page-head">
  <div>
    <div class="eyebrow">Financeiro</div>
    <h1>A pagar · <%= month_label(selected_month) %></h1>
    <p class="lead">Criado automaticamente quando o mês é aprovado na conferência. Pagamento no dia 10.</p>
  </div>
  <div class="actions">
    <%= month_switcher(:statements_path) %>
    <%= link_to statements_path(format: :csv, mes: month_param(selected_month)), class: "btn btn-secondary" do %><%= icon("file-csv") %>Exportar<% end %>
    <% if current_user.can_pay? %><%= link_to paid_statements_path, class: "btn btn-ghost" do %><%= icon("check-double") %>Pagos<% end %><% end %>
  </div>
</div>

<div class="grid grid-3 stagger">
  <div class="card kpi"><div class="kpi-label"><%= icon("wallet") %>Total a pagar</div><div class="kpi-value"><%= brl(total) %></div><div class="kpi-sub"><%= pluralize(@statements.size, "pagamento") %></div></div>
  <div class="card kpi"><div class="kpi-label"><%= icon("calendar") %>Próximo vencimento</div><div class="kpi-value"><%= date_br(by_due.keys.compact.min) || "—" %></div><div class="kpi-sub"><%= brl(by_due[by_due.keys.compact.min].to_a.sum { _1.amount_payable.to_d }) %></div></div>
  <div class="card kpi"><div class="kpi-label"><%= icon("triangle-exclamation") %>Vencidos</div><% late = @statements.select { _1.due_on && _1.due_on < Date.current } %><div class="kpi-value"><%= late.size %></div><div class="kpi-sub"><%= brl(late.sum { _1.amount_payable.to_d }) %></div></div>
</div>

<% if @other_months.any? %>
  <div class="callout" style="margin-top:18px"><%= icon("circle-info") %><span>
    Também há a pagar em outros meses:
    <%= safe_join(@other_months.map { |month, n| link_to("#{month_label(month, short: true)} (#{n})", statements_path(mes: month_param(month))) }, " · ") %>
  </span></div>
<% end %>

<% if @statements.empty? %>
  <div class="card" style="margin-top:18px"><div class="empty"><i class="fa-solid fa-wallet"></i><b>Nada a pagar em <%= month_label(selected_month) %></b>Os pagamentos aparecem aqui quando o mês é aprovado na <%= link_to "conferência", reviews_path %>.</div></div>
<% end %>

<% by_due.sort_by { |d, _| d || Date.new(3000) }.each do |due, list| %>
  <div class="card" style="margin-top:18px">
    <div class="card-head">
      <h2>Vencimento <%= date_br(due) %><% if due && due < Date.current %> <span class="chip chip-error">Vencido</span><% end %></h2>
      <span class="muted" style="margin-left:auto"><%= pluralize(list.size, "pagamento") %> · <b style="color:var(--text)"><%= brl(list.sum { _1.amount_payable.to_d }) %></b></span>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Influenciadora</th><th>Chave PIX</th><th>Competência</th><th>Aprovado por</th><th class="right">Valor</th><th class="right"><%= current_user.can_pay? ? "Pagamento" : "" %></th></tr></thead>
        <tbody>
          <% list.each do |s| %>
            <% i = s.influencer %>
            <tr>
              <td><%= link_to review_path(s), class: "person" do %><%= avatar(i.initials) %><span><b><%= i.name %></b><small>@<%= i.instagram %></small></span><% end %></td>
              <td class="mono small"><%= i.pix_label || tag.span("a informar", class: "muted") %></td>
              <td><%= month_label(s.month, short: true) %></td>
              <td class="small muted"><%= s.reviewed_by&.display_name %> · <%= date_br(s.reviewed_at) %></td>
              <td class="right nowrap"><b><%= brl(s.amount_payable) %></b></td>
              <td class="right">
                <% if current_user.can_pay? %>
                  <details class="inline-pay">
                    <summary class="btn btn-primary btn-sm"><%= icon("check") %>Marcar pago</summary>
                    <%= form_with url: pay_statement_path(s), class: "pay-pop" do |f| %>
                      <%= f.text_field :amount, value: number_with_precision(s.amount_payable, precision: 2, separator: ",", delimiter: "."), inputmode: "decimal", title: "Valor pago" %>
                      <%= f.button "Confirmar", class: "btn btn-secondary btn-sm" %>
                    <% end %>
                  </details>
                <% else %>
                  <%= status_chip("open", "A pagar") %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
