<% content_for :title, staff? ? "Comprovações" : "Minhas comprovações" %>

<div class="page-head">
  <div>
    <div class="eyebrow"><%= staff? ? "Marketing" : "Minha parceria" %></div>
    <h1><%= staff? ? "Comprovações" : "Minhas comprovações" %></h1>
    <p class="lead"><%= staff? ? "Confira os prints e links enviados pelas parceiras. Aprovar conta para a meta do mês." : "Tudo o que você enviou e a situação de cada envio." %></p>
  </div>
  <div class="actions">
    <%= link_to new_proof_path, class: "btn btn-primary" do %><%= icon("cloud-arrow-up") %><%= staff? ? "Lançar comprovação" : "Enviar comprovação" %><% end %>
  </div>
</div>

<div class="card" style="margin-bottom:16px">
  <div class="toolbar" style="border-bottom:0">
    <div class="seg">
      <% { "pending" => "Em análise", "approved" => "Aprovadas", "rejected" => "Recusadas", "todas" => "Todas" }.each do |key, label| %>
        <%= link_to proofs_path(request.query_parameters.merge(status: key)), class: ("is-active" if @status == key) do %><%= label %><% n = key == "todas" ? @counts.values.sum : @counts[key].to_i %><span class="count"><%= n %></span><% end %>
      <% end %>
    </div>
    <div class="seg">
      <%= link_to "Todos os canais", proofs_path(request.query_parameters.except(:kind)), class: ("is-active" if params[:kind].blank?) %>
      <% Influencer::CHANNELS.each do |k| %><%= link_to Influencer.channel_label(k), proofs_path(request.query_parameters.merge(kind: k)), class: ("is-active" if params[:kind] == k) %><% end %>
    </div>
    <% if staff? %>
      <%= form_with url: proofs_path, method: :get, class: "toolbar-filter", data: { controller: "autosubmit" } do %>
        <% request.query_parameters.except("influencer_id").each do |k, v| %><%= hidden_field_tag k, v %><% end %>
        <%= icon("user") %>
        <%= select_tag :influencer_id, options_for_select(@influencer_options, params[:influencer_id]), include_blank: "Todas as influenciadoras", class: "input", "aria-label": "Filtrar por influenciadora", data: { action: "change->autosubmit#submit" } %>
        <noscript><button class="btn btn-secondary btn-sm">Filtrar</button></noscript>
      <% end %>
    <% end %>
  </div>
</div>

<% if @proofs.any? %>
  <div class="proof-cards"><%= render partial: "proofs/card", collection: @proofs, as: :proof %></div>
<% else %>
  <div class="card"><div class="empty"><i class="fa-regular fa-images"></i><b>Nada por aqui</b>Nenhuma comprovação com esse filtro.</div></div>
<% end %>
