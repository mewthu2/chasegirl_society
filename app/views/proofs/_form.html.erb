<%# locals: proof, portal (true quando embutido na Minha área) %>
<% portal = local_assigns.fetch(:portal, false) %>
<%= form_with model: proof, class: "form", data: { controller: "upload" } do |f| %>
  <%= render "shared/errors", record: proof unless portal %>
  <%= hidden_field_tag :return_to, portal ? "portal" : params[:return_to] %>
  <%= hidden_field_tag :mes, month_param(selected_month) if portal %>

  <div class="card">
    <div class="card-head">
      <h2><%= portal ? "Comprovar combinados" : "O que você está comprovando?" %></h2>
      <% if portal %><span class="muted small" style="margin-left:auto">Uma tarefa por envio · link + fotos obrigatórios</span><% end %>
    </div>
    <div class="card-body form-grid">
      <% if staff? && proof.new_record? %>
        <% if proof.influencer %>
          <%= f.hidden_field :influencer_id %>
        <% else %>
          <div class="field span-12">
            <%= f.label :influencer_id, "Influenciadora" %>
            <%= f.collection_select :influencer_id, Influencer.active.ordered, :id, :name, { prompt: "Escolha…" }, required: true %>
          </div>
        <% end %>
      <% end %>
      <% contracted = proof.influencer&.channels || Influencer::CHANNELS %>
      <div class="span-12 kind-picker">
        <% Influencer::CHANNELS.each do |k| %>
          <div class="kind-option">
            <%= f.radio_button :kind, k, disabled: !contracted.include?(k), required: true %>
            <label for="proof_kind_<%= k %>">
              <%= icon(channel_icon(k)) %>
              <b><%= Influencer.channel_label(k) %></b>
              <small><%= { "feed" => "Post no feed ou Reels", "stories" => "Um story por envio", "tiktok" => "Vídeo publicado no TikTok" }[k] %><%= " · não contratado" unless contracted.include?(k) %></small>
            </label>
          </div>
        <% end %>
      </div>
      <div class="field span-8"><%= f.label :link, "Link da publicação *" %><%= f.text_field :link, required: true, inputmode: "url", placeholder: "https://instagram.com/…" %><span class="hint">Copie o link do post, reels, story ou TikTok</span></div>
      <div class="field span-4"><%= f.label :posted_on, "Data da publicação" %><%= f.date_field :posted_on, max: Date.current %></div>

      <div class="span-12">
        <% if proof.persisted? && proof.images.attached? %>
          <div class="gallery" style="margin-bottom:14px"><% proof.images.each do |img| %><%= link_to media_thumb(img), url_for(img), target: "_blank" %><% end %></div>
        <% end %>
        <div class="dropzone" data-upload-target="zone" data-action="dragover->upload#over dragleave->upload#leave drop->upload#leave">
          <div class="dz-icon"><%= icon("camera") %></div>
          <b>Toque para adicionar as fotos *</b>
          <small>Quantas fotos precisar para comprovar esta tarefa (prints, fotos do post, telas do vídeo) · até <%= Proof::MAX_IMAGES %></small>
          <%= f.file_field :images, multiple: true, accept: "image/*,video/*", required: proof.new_record?, data: { upload_target: "input", action: "change->upload#changed" } %>
        </div>
        <div class="previews" data-upload-target="previews"></div>
        <span class="uploading" style="margin-top:10px"><span class="spinner"></span>Preparando as fotos…</span>
      </div>
      <div class="field span-12"><%= f.label :description, "Observação (opcional)" %><%= f.text_area :description, rows: 2, placeholder: "Algo que a equipe Chase precisa saber?" %></div>
    </div>
  </div>

  <div class="form-actions">
    <% if staff? && proof.new_record? && !portal %><label class="check" style="margin-right:auto"><%= check_box_tag :approve_now, "1", false %> Já aprovar ao salvar</label><% end %>
    <% unless portal %><%= link_to "Cancelar", proof.persisted? ? proof_path(proof) : (staff? ? proofs_path : portal_path), class: "btn btn-ghost" %><% end %>
    <%= f.button class: "btn btn-primary btn-lg", data: { upload_target: "submit", turbo_submits_with: "Enviando…" } do %><%= icon("paper-plane") %><%= proof.persisted? ? "Salvar" : "Enviar comprovação" %><% end %>
  </div>
<% end %>
