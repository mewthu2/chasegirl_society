<% content_for :title, staff? ? "Área de #{@influencer.name}" : "Minha área" %>
<% s = @statement; i = @influencer %>
<% extra = staff? ? { influencer_id: i.id } : {} %>

<% if staff? %>
  <div class="callout" style="margin-bottom:16px"><%= icon("eye") %><span>Você está vendo a área como <b><%= i.name %></b> enxerga. <%= link_to "Voltar para a ficha", influencer_path(i) %></span></div>
<% end %>

<div class="hero">
  <div class="hero-row">
    <div class="ring" style="--p: <%= s.progress_percent %>"><span><%= s.progress_percent %>%</span></div>
    <div>
      <div class="eyebrow">Chase Society · <%= month_label(selected_month) %></div>
      <h1>Oi, <%= i.name.split.first %>!</h1>
      <p><%= if s.approved? then "Mês aprovado! Obrigada 🖤" elsif s.goal_met? then "Meta do mês completa. Agora é com a equipe Chase na conferência." else "Envie as provas das suas publicações para completar a meta do mês." end %></p>
    </div>
    <div class="actions">
      <%= month_switcher(:portal_path, **extra) %>
    </div>
  </div>
</div>

<div class="quick-actions">
  <%= link_to new_proof_path(extra), class: "quick-action quick-action-primary" do %>
    <span class="qa-icon"><%= icon("cloud-arrow-up") %></span>
    <span class="qa-txt"><b>Enviar comprovações</b><small>Prints e links dos stories e posts</small></span>
    <%= icon("arrow-right", class: "qa-go") %>
  <% end %>
  <%= link_to proofs_path(extra), class: "quick-action" do %>
    <span class="qa-icon"><%= icon("images") %></span>
    <span class="qa-txt"><b>Minhas comprovações</b><small>Histórico e situação dos envios</small></span>
    <%= icon("arrow-right", class: "qa-go") %>
  <% end %>
  <% c = @coupon %>
  <div class="quick-action quick-coupon" data-controller="copy">
    <span class="qa-icon"><%= icon("ticket") %></span>
    <span class="qa-txt">
      <small>Cupom de permuta · <%= brl(i.permuta_value) %></small>
      <% if c[:code].present? %>
        <b class="mono" data-copy-target="source"><%= c[:code] %></b>
      <% else %>
        <b>Sem cupom</b>
      <% end %>
      <% if c[:ok] %>
        <small class="qa-usage">
          <% if c[:usage_limit] %>
            <b><%= c[:remaining] %></b> de <%= c[:usage_limit] %> <%= c[:usage_limit] == 1 ? "uso disponível" : "usos disponíveis" %> · usado <%= c[:used] %>x
          <% else %>
            Usos ilimitados · usado <%= c[:used] %>x
          <% end %>
          <%= { "EXPIRED" => " · expirado", "SCHEDULED" => " · agendado" }[c[:status]] %>
        </small>
      <% else %>
        <small class="qa-usage qa-error"><%= icon("triangle-exclamation") %> <%= staff? ? c[:error] : "Cupom ainda não liberado na loja. Fale com a equipe Chase." %></small>
      <% end %>
    </span>
    <% if c[:ok] %>
      <button type="button" class="btn btn-secondary btn-sm" data-action="copy#copy" data-copy-target="button"><%= icon("copy") %><span>Copiar</span></button>
    <% end %>
  </div>
</div>

<%= render "shared/channels", statement: s %>

<div class="card" style="margin-top:16px">
  <div class="card-head">
    <h2>Como funciona o mês</h2>
    <span class="muted small" style="margin-left:auto">Combinado <%= brl(s.amount_contracted) %> · cupom <span class="mono"><%= i.coupon_code || "—" %></span></span>
  </div>
  <div class="card-body">
    <%= render "shared/cycle", statement: s %>
    <p class="muted small" style="margin-top:12px">Você entrega até o fim do mês. Do dia 1 ao 10 do mês seguinte a equipe Chase confere; aprovado, o seu cupom ganha +1 uso (permuta de <%= brl(i.permuta_value) %>) e o pagamento sai no dia 10.</p>
  </div>
</div>

<div class="card" style="margin-top:18px">
  <div class="card-head"><h2>Envios de <%= month_label(selected_month) %></h2></div>
  <% if @proofs.any? %>
    <div class="card-body"><div class="proof-cards"><%= render partial: "proofs/card", collection: @proofs, as: :proof %></div></div>
  <% else %>
    <div class="empty"><i class="fa-regular fa-images"></i><b>Nenhum envio neste mês</b>Os envios do mês aparecem aqui.</div>
  <% end %>
</div>

<% if @history.any? %>
  <div class="card">
    <div class="card-head"><h2>Meses anteriores</h2></div>
    <div class="list">
      <% @history.each do |h| %>
        <%= link_to portal_path(extra.merge(mes: month_param(h.month))), class: "list-item" do %>
          <div class="grow"><b><%= month_label(h.month) %></b><div class="muted small"><%= h.progress_percent %>% das metas · <%= brl(h.amount_due) %></div></div>
          <%= status_chip(h.payment_status, h.payment_label) %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
