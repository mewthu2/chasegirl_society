<%= form_with model: user, class: "form" do |f| %>
  <%= render "shared/errors", record: user %>
  <div class="card"><div class="card-body form-grid">
    <div class="field span-6"><%= f.label :name, "Nome" %><%= f.text_field :name %></div>
    <div class="field span-6"><%= f.label :email_address, "E-mail" %><%= f.email_field :email_address, required: true %></div>
    <div class="field span-6"><%= f.label :role, "Perfil" %><%= f.select :role, [["Gerente — vê tudo, configura metas; no financeiro só o A pagar", "manager"], ["Admin — vê e faz tudo, inclusive pagamentos", "admin"]], {}, disabled: user == current_user %></div>
    <% if user.new_record? %><div class="span-12 callout"><%= icon("envelope") %><span>A pessoa recebe um convite por e-mail para criar a própria senha (vale 7 dias).</span></div><% end %>
  </div></div>
  <div class="form-actions"><%= link_to "Cancelar", users_path, class: "btn btn-ghost" %><%= f.button user.new_record? ? "Cadastrar e enviar convite" : "Salvar", class: "btn btn-primary" %></div>
<% end %>
