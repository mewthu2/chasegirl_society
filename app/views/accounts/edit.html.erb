<% content_for :title, "Minha conta" %>
<div class="page-head"><div><div class="eyebrow">Conta</div><h1>Minha conta</h1><p class="lead"><%= current_user.email_address %></p></div></div>
<%= form_with url: account_path, method: :patch, class: "form", style: "max-width:640px", data: { turbo: false } do |f| %>
  <div class="card"><div class="card-body form-grid">
    <div class="field span-12"><%= f.label :name, "Nome" %><%= f.text_field :name, value: current_user.name %></div>
    <div class="field span-6"><%= f.label :password, "Nova senha" %><%= f.password_field :password, autocomplete: "new-password", placeholder: "vazio mantém a atual" %></div>
    <div class="field span-6"><%= f.label :password_confirmation, "Confirme a nova senha" %><%= f.password_field :password_confirmation, autocomplete: "new-password" %></div>
    <div class="field span-12"><%= f.label :current_password, "Senha atual (obrigatória)" %><%= f.password_field :current_password, required: true, autocomplete: "current-password" %></div>
  </div></div>
  <div class="form-actions"><%= f.button "Salvar", class: "btn btn-primary" %></div>
<% end %>
