<% content_for :title, "Conferência" %>

<div class="page-head">
  <div>
    <div class="eyebrow">Marketing</div>
    <h1>Conferência · <%= month_label(selected_month) %></h1>
    <p class="lead">Do dia 1 ao 10 do mês seguinte: confira as entregas, aprove ou reprove o mês de cada influenciadora.</p>
  </div>
  <div class="actions"><%= month_switcher(:reviews_path, filtro: params[:filtro]) %></div>
</div>

<%= render "reviews/phase_banner" %>

<div class="grid grid-4 stagger">
  <div class="card kpi"><div class="kpi-label"><%= icon("magnifying-glass") %>Aguardando</div><div class="kpi-value"><%= @counts["open"].to_i %></div><div class="kpi-sub">para conferir</div></div>
  <div class="card kpi"><div class="kpi-label"><%= icon("check") %>Aprovados</div><div class="kpi-value"><%= @counts["approved"].to_i %></div><div class="kpi-sub">cupom renovado + a pagar criado</div></div>
  <div class="card kpi"><div class="kpi-label"><%= icon("xmark") %>Reprovados</div><div class="kpi-value"><%= @counts["rejected"].to_i %></div><div class="kpi-sub">sem pagamento</div></div>
  <div class="card kpi"><div class="kpi-label"><%= icon("hourglass-half") %>Provas pendentes</div><div class="kpi-value"><%= Proof.pending.for_month(selected_month).count %></div><div class="kpi-sub"><%= link_to "conferir comprovações", proofs_path(mes: month_param(selected_month)) %></div></div>
</div>

<div class="card" style="margin-top:18px">
  <div class="toolbar">
    <div class="seg">
      <% { "todas" => "Todas", "open" => "Aguardando", "approved" => "Aprovadas", "rejected" => "Reprovadas" }.each do |key, label| %>
        <%= link_to label, reviews_path(mes: month_param(selected_month), filtro: key), class: ("is-active" if @filter == key) %>
      <% end %>
    </div>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th>Influenciadora</th><% Influencer::CHANNELS.each do |k| %><th><%= Influencer.channel_label(k) %></th><% end %><th class="right">Combinado</th><th class="right">Sugerido</th><th class="right">Conferência</th></tr>
      </thead>
      <tbody>
        <% @statements.each do |s| %>
          <% i = s.influencer %>
          <tr>
            <td><%= link_to review_path(s), class: "person" do %><%= avatar(i.initials) %><span><b><%= i.name %></b><small>@<%= i.instagram %><%= " · #{s.pending_total} em análise" if s.pending_total.positive? %></small></span><% end %></td>
            <% Influencer::CHANNELS.each do |k| %>
              <td class="nowrap">
                <% if i.goal_for(k).positive? %>
                  <span title="<%= percent(i.share_percent(k)) %> · <%= brl(i.channel_value(k)) %>"><%= s.channel_met?(k) ? icon("circle-check") : icon("circle", class: "muted") %> <%= s.delivered_for(k) %>/<%= i.goal_for(k) %></span>
                <% else %><span class="muted">—</span><% end %>
              </td>
            <% end %>
            <td class="right nowrap muted"><%= brl(s.amount_contracted) %></td>
            <td class="right nowrap"><b><%= brl(s.amount_due) %></b></td>
            <td class="right"><%= render "reviews/approve_form", statement: s, compact: true %></td>
          </tr>
        <% end %>
        <% if @statements.empty? %><tr><td colspan="7"><div class="empty"><i class="fa-solid fa-magnifying-glass"></i><b>Nada para conferir</b></div></td></tr><% end %>
      </tbody>
    </table>
  </div>
</div>
