<%# locals: statement, compact %>
<% s = statement %>
<% if s.paid? %>
  <%= status_chip("paid", "Pago #{brl(s.amount_paid)}") %>
<% elsif s.review_open? && s.phase == :running %>
  <span class="muted small"><%= icon("lock") %> Conferência a partir de <%= date_br(s.review_start) %></span>
<% elsif s.review_open? %>
  <%= form_with url: approve_review_path(s), class: "approve-form" do |f| %>
    <%= f.text_field :amount, value: number_with_precision(s.amount_due, precision: 2, separator: ",", delimiter: "."), inputmode: "decimal", title: "Valor do a pagar (sugestão: canais cumpridos)" %>
    <% unless local_assigns[:compact] %>
      <%= f.text_field :note, placeholder: "Observação", style: "width:180px" %>
      <label class="check small"><%= f.check_box :renew_coupon, { checked: true }, "1", "0" %> Renovar cupom</label>
    <% end %>
    <%= f.button class: "btn btn-primary btn-sm", data: { turbo_confirm: "Aprovar o mês de #{s.influencer.name}? Cria o a pagar e renova o cupom (+1 uso na Shopify)." } do %><%= icon("check") %>Aprovar<% end %>
  <% end %>
  <%= form_with url: reject_review_path(s), class: "approve-form", html: { style: "margin-top:6px" } do |f| %>
    <% unless local_assigns[:compact] %><%= f.text_field :note, placeholder: "Motivo da reprovação", style: "width:220px" %><% end %>
    <%= f.button class: "btn btn-ghost btn-sm", data: { turbo_confirm: "Reprovar o mês de #{s.influencer.name}? Não gera pagamento nem renova o cupom." } do %><%= icon("xmark") %>Reprovar<% end %>
  <% end %>
<% else %>
  <div class="row-actions">
    <%= status_chip(s.review_status, s.approved? ? "Aprovado · #{brl(s.amount_payable)}" : s.review_label) %>
    <% if s.approved? && !s.coupon_done? && s.influencer.coupon_code.present? %>
      <%= button_to coupon_review_path(s), class: "btn btn-secondary btn-sm", title: s.coupon_error do %><%= icon("rotate") %>Renovar cupom<% end %>
    <% end %>
    <%= button_to icon("rotate-left"), reopen_review_path(s), class: "icon-btn", title: "Voltar para conferência", form: { data: { turbo_confirm: "Voltar #{s.influencer.name} para conferência? O a pagar é removido." } } %>
  </div>
<% end %>
