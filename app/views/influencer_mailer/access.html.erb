<% content_for :preheader, "Seu login para enviar as provas dos stories e acompanhar suas metas." %>
<% content_for :badge, "Seu acesso" %>
<% content_for :hero_title, "Oi, #{@influencer&.name.to_s.split.first || 'tudo bem'}! Seu acesso chegou." %>

<p style="margin:0 0 14px;">Agora você faz parte do painel da <strong>Chasegirl Society</strong>. É por lá que você envia os prints dos seus stories, posts e TikToks, acompanha as metas do mês, o pagamento e o seu cupom.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f4f4;border:1px solid #dddddd;border-radius:12px;">
  <tr><td style="padding:16px 18px;">
    <div style="font-size:12px;color:#7a7a7a;text-transform:uppercase;letter-spacing:1px;">E-mail de login</div>
    <div style="font-size:16px;font-weight:700;color:#0b0b0b;margin-top:2px;"><%= @user.email_address %></div>
    <div style="font-size:12px;color:#7a7a7a;text-transform:uppercase;letter-spacing:1px;margin-top:14px;">Senha</div>
    <div style="font-family:Menlo,Consolas,monospace;font-size:18px;font-weight:700;color:#0b0b0b;letter-spacing:1px;margin-top:2px;"><%= @password %></div>
  </td></tr>
</table>

<%= render "shared/mail_button", url: @url, label: "Entrar no painel" %>

<% if @influencer %>
  <p style="margin:0 0 8px;"><strong>Suas metas por mês:</strong></p>
  <ul style="margin:0 0 16px;padding-left:20px;">
    <% @influencer.channels.each do |k| %><li><%= @influencer.goal_for(k) %> <%= Influencer.channel_label(k) %></li><% end %>
  </ul>
  <% if @influencer.coupon_code.present? %><p style="margin:0 0 14px;">Seu cupom: <strong style="font-family:Menlo,Consolas,monospace;"><%= @influencer.coupon_code %></strong></p><% end %>
<% end %>

<p style="margin:0;color:#6a6a6a;font-size:13px;">Dica: depois de entrar, troque a senha em <em>Minha conta</em>.</p>

<% content_for :why, "A equipe Chase criou o seu acesso à Chasegirl Society, o painel das parceiras da marca." %>
