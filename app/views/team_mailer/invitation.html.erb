<% content_for :preheader, "Crie sua senha para acessar o painel da Chasegirl Society." %>
<% content_for :badge, "Equipe Chase" %>
<% content_for :hero_title, "Oi#{", #{@user.name.split.first}" if @user.name.present?}! Seu acesso está pronto." %>

<p style="margin:0 0 14px;">Você foi cadastrado(a) como <strong><%= @user.role_label %></strong> na <strong>Chasegirl Society</strong>, o painel das parceiras da Chase: influenciadoras, comprovações, conferência mensal e financeiro.</p>
<% if @user.manager? %>
  <p style="margin:0 0 14px;">Como Gerente, você configura as metas e os valores de cada influenciadora, confere as entregas e acompanha o A pagar.</p>
<% end %>

<%= render "shared/mail_button", url: @url, label: "Criar minha senha" %>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f4f4;border:1px solid #dddddd;border-radius:12px;">
  <tr><td style="padding:16px 18px;">
    <div style="font-size:12px;color:#7a7a7a;text-transform:uppercase;letter-spacing:1px;">Seu login</div>
    <div style="font-size:16px;font-weight:700;color:#0b0b0b;margin-top:2px;"><%= @user.email_address %></div>
  </td></tr>
</table>

<p style="margin:16px 0 0;color:#6a6a6a;font-size:13px;">O link vale até <%= l(@expires_on, format: "%d/%m/%Y") %> e só pode ser usado uma vez.</p>

<% content_for :why, "Um administrador da Chase cadastrou este e-mail na equipe da Chasegirl Society." %>
